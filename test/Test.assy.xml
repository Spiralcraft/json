<test:TestGroup
  xmlns:task="class:/spiralcraft/task/"
  xmlns:test="class:/spiralcraft/test/"
  xmlns:j="class:/java/lang/"
  xmlns:ju="class:/java/util/"
  xmlns:jn="class:/java/net/"
  xmlns:lang="class:/spiralcraft/lang"
  xmlns:fn="class:/spiralcraft/lang/functions/"
  xmlns:util="class:/spiralcraft/util/"
  xmlns:sutil="class:/spiralcraft/util/string/"
  xmlns:vfs="class:/spiralcraft/vfs/"
  xmlns:vfsf="class:/spiralcraft/vfs/functions/"
  xmlns:json="class:/spiralcraft/json/"
  xmlns:example="class:/spiralcraft/data/test/example/"
  xmlns:langtest="class:/spiralcraft/lang/test/"
  xmlns:jt="class:/spiralcraft/json/test/"
  xmlns="dynamic:/"
  >
  <name>spiralcraft.lang.test
  </name>
  
  <chain>
 
    <task:Sequence>
      <scenarios>
    
        <test:Assertion>
        
          <name>Simple serialization of a reflector
          </name>
          
          <subjectX>[test:Assertion]{{ name:=..name }}.[*json:ToJson]
          </subjectX>
          
          <testX>.contains([test:Assertion].name)
          </testX>
          
        </test:Assertion>
        
        <test:Assertion>
        
          <name>Escape test
          </name>
          
          <subjectX>
            "Using the formula: (W + I) * C where W = the constant of wood, which is well known to be 61, as agreed in many scientific circles. I = the variable in this equation, and stands for the word 'if' from the original problem. As there are three circumstances, with 0 equaling the chance that the woodchuck cannot chuck wood, 1 being the theory that the woodchuck can chuck wood but chooses not to, and 2 standing for the probability that the woodchuck can and will chuck wood, we clearly must choose 2 for use in this equation. C = the constant of Chuck Norris, whose presence in any problem involving the word chuck must there, is well known to equal 1.1 of any \"known being\", therefore the final part of this calculation is 1.1. As is clear, this appears to give the answer of (61 + 2) * 1.1 = (63) * 1.1 = 69.3 units of wood."
            .[*json:ToJson]
          </subjectX>
          
          <testX>true
          </testX>
          
        </test:Assertion>
        
        <test:Assertion>
        
          <name>Primitive String
          </name>
          
          <subjectX>
            "yo"
            .[*json:ToJson]
          </subjectX>
          
          <testX>.=="\"yo\""
          </testX>
          
        </test:Assertion>

        <test:Assertion>
        
          <name>Primitive Number
          </name>
          
          <subjectX>
            3.14159265
            .[*json:ToJson]
          </subjectX>
          
          <testX>.=="3.14159265"
          </testX>
          
        </test:Assertion>

        <test:Assertion>
        
          <name>Primitive Boolean true
          </name>
          
          <subjectX>
            true
            .[*json:ToJson]
          </subjectX>
          
          <testX>.=="true"
          </testX>
          
        </test:Assertion>

        <test:Assertion>
        
          <name>Primitive Boolean false
          </name>
          
          <subjectX>
            false
            .[*json:ToJson]
          </subjectX>
          
          <testX>.=="false"
          </testX>
          
        </test:Assertion>

        <test:Assertion>
        
          <name>Round trip
          </name>
          
          <subjectX>
            [@json:Node].@formatToString
              ([@json:Node].@parse("{ x:\"one\", y:2, z:false}")
              )
          </subjectX>
          
          <testX>
            .==("\r\n{\"x\" :  \"one\",\r\n  \"y\" :  2,\r\n  \"z\" :  false\r\n}")
          </testX>
          
        </test:Assertion>
        
        <test:Assertion>
        
          <name>DataReader-1
          </name>
          
          <subjectX>
            [*jn:URI{"in/test2-foreign.json"}]
                .[*vfsf:Resolve]
                .[*vfsf:IO]
                .[*json:FromJson{[@example:Customer]}]
          </subjectX>
          
          <testX>
            .{.@log("Text:"+.@tuple.toText("")),true}
          </testX>
          
        </test:Assertion>        
        
        <test:Assertion>
        
          <name>DataReader-2
          </name>
          
          <subjectX>
            [*jn:URI{"in/test3-foreign.json"}]
                .[*vfsf:Resolve]
                .[*vfsf:IO]
                .[*json:FromJson{[@example:Customer]}]
          </subjectX>
          
          <testX>
            true 
          </testX>
          
        </test:Assertion>      
        
        <test:Assertion>
        
          <name>Parse
          </name>
          
          <subjectX>
            "[\"Hello\"]".[*json:FromJson{[@j:String][]}]
          </subjectX>
          
          <testX>
            true 
          </testX>
          
        </test:Assertion>     
        
        <test:Assertion>
        
          <name>Unicode
          </name>
          
          <subjectX>
            "[\"\\\u0040Hello\"]".[*json:FromJson{[@j:String][]}]
          </subjectX>
          
          <testX>
            true 
          </testX>
          
        </test:Assertion>  
        
        <test:Assertion>
        
          <name>Read file to node
          </name>
          
          <subjectX>
            [@json:Node].@formatToString
              ([@json:Node].@parse
                ([@j:String]
                  .([*jn:URI{"in/test4-foreign.json"}]
                    .[*vfsf:Resolve]
                    .[*vfsf:IO]
                  )
                )
              )
          </subjectX>
          
          <testX>
            true
          </testX>
          
        </test:Assertion>        

        <test:Assertion>
        
          <name>Struct to JSON 1
          </name>
          
          <subjectX>
            { name:="John Doe"
            , amount:=15.432
            , active:=true
            , missing:=null
            }.[*json:ToJson]
          </subjectX>

          <textLiteral whitespace="true" normalizeEOL="true"><![CDATA[
{"name" :  "John Doe",
  "amount" :  15.432,
  "active" :  true
}]]></textLiteral>
        
        </test:Assertion>        


        <test:Assertion>
        
          <name>Struct from JSON 1
          </name>
          
          <subjectX>
            "{ \"name\": \"John Doe\", \"amount\": 15.432, \"active\": true }"
              .[*json:FromJson{
                { name:[@j:String]
                , amount:[@j:Float]
                , active:[@j:Boolean]
                , missing:[@j:Void]
                }
              }]
          </subjectX>
          
          <testX><![CDATA[
            name=="John Doe" && amount==15.432 && active
            ]]>
          </testX>
        </test:Assertion>
        
        <test:Assertion>
        
          <name>Array type single element
          </name>
          
          <subjectX>
            [{ "one" }].[*json:ToJson]
          </subjectX>
          
          <textLiteral whitespace="true" normalizeEOL="true"><![CDATA[
["one"
]]]></textLiteral>
        </test:Assertion>
        
        <test:Assertion>
        
          <name>Array struct
          </name>
          
          <subjectX>
            [{ "one","two","three" }]
            #{ { x:=.. } }
            .[*json:ToJson]
          </subjectX>
          
          <textLiteral whitespace="true" normalizeEOL="true"><![CDATA[
[
  {"x" :  "one"
  },
  
  {"x" :  "two"
  },
  
  {"x" :  "three"
  }
]]]></textLiteral>

        </test:Assertion>

        <test:Assertion>
        
          <name>Array in struct
          </name>
          
          <subjectX>
            { foo:="hello"
              ,barA:=[{ "one","two","three" }]
            }
            .[*json:ToJson]
          </subjectX>
          
          <textLiteral whitespace="true" normalizeEOL="true"><![CDATA[
{"foo" :  "hello",
  "barA" :  
  ["one",
    "two",
    "three"
  ]
}]]></textLiteral>

        </test:Assertion>

        <test:Assertion>
        
          <name>Object output
          </name>
          
          <subjectX>[@langtest:Bar].()
            .[*json:ToJson]
          </subjectX>
          
          <textLiteral whitespace="true" normalizeEOL="true"><![CDATA[
{"theArray" :  
  ["one",
    "two",
    "three"
  ],
  "theField" :  "default"
}]]></textLiteral>

        </test:Assertion>
        
        <test:Assertion>
          <name>Struct array input
          </name>
        
          <subjectX>
            "[ {title: \"one\" },{ title: \"two\"},{ title: \"three\"} ]"
            .[*json:FromJson
                { 
                  [{ 
                    { title:[@j:String] 
                    } 
                  }].@type
            
                }
              ]
            
            
          </subjectX>
          
          <testX>@[2].title=="three"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>Empty object input
          </name>
        
          <subjectX>
            "{ name: \"test\", postalAddress: {} }"
            .[*json:FromJson
                { 
                   
                  { name:[@j:String]
                  , postalAddress:={ city:="" }
                  }.@type
            
                }
              ]
            
            
          </subjectX>
          
          <testX>.name=="test"
          </testX>
        </test:Assertion>
        
        <test:Assertion>
          <name>CR Escape
          </name>
        
          <subjectX>
            "{ name: \&quot;hello\\nthere\&quot; }"
            .[*json:FromJson
                { 
                  { name:[@j:String]
                  }
            
                }
              ]
            
            
          </subjectX>
          
          <testX>.name=="hello\nthere"
          </testX>
        </test:Assertion>
        
        <test:Assertion>
        
          <name>Read file with CRs
          </name>
          
          <subjectX>
            [*jn:URI{"in/test5-foreign.json"}]
                .[*vfsf:Resolve]
                .[*vfsf:IO]
                .[*json:FromJson{ { summary:[@j:String]} }]

          </subjectX>
          
          <testX>
            .summary=="Awesome dude\n\nreally cool\n\nanother line"
          </testX>
          
        </test:Assertion>        

        <test:Assertion>
        
          <name>Dir Listing
          </name>
          
          <subjectX>
            [*jn:URI{"in"}]
                .[*vfsf:Resolve]
                .children#{ { name:=..localName, size:=..size, lastModified:=..lastModified } }
                .[*json:ToJson{ debug:=true} ]

          </subjectX>
          
          <testX>
            true
          </testX>
          
        </test:Assertion>        

        <test:Assertion>
          <name>MemberNames toIdentifier @meta
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.toIdentifier("@meta")
          </subjectX>
          <testX>.=="__at__meta"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames toMember __at__meta
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.toMember("__at__meta")
          </subjectX>
          <testX>.=="@meta"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames toIdentifier a__b
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.toIdentifier("a__b")
          </subjectX>
          <testX>.=="a__us__b"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames toMember a__us__b
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.toMember("a__us__b")
          </subjectX>
          <testX>.=="a__b"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames leaves tool_call_id
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.toIdentifier("tool_call_id")
          </subjectX>
          <testX>.=="tool_call_id"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames wrapping CamelSnake toIdentifier @meta
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.wrap([@sutil:CamelSnakeConverter].@INSTANCE).toIdentifier("@meta")
          </subjectX>
          <testX>.=="__at__meta"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames wrapping CamelSnake toMember __at__meta
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.wrap([@sutil:CamelSnakeConverter].@INSTANCE).toMember("__at__meta")
          </subjectX>
          <testX>.=="@meta"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames wrapping CamelSnake toIdentifier tool_call_id
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.wrap([@sutil:CamelSnakeConverter].@INSTANCE).toIdentifier("tool_call_id")
          </subjectX>
          <testX>.=="toolCallId"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames wrapping CamelSnake toMember toolCallId
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.wrap([@sutil:CamelSnakeConverter].@INSTANCE).toMember("toolCallId")
          </subjectX>
          <testX>.=="tool_call_id"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames wrapping CamelSnake toIdentifier a__b
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.wrap([@sutil:CamelSnakeConverter].@INSTANCE).toIdentifier("a__b")
          </subjectX>
          <testX>.=="a__us__b"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames wrapping CamelSnake toMember a__us__b
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.wrap([@sutil:CamelSnakeConverter].@INSTANCE).toMember("a__us__b")
          </subjectX>
          <testX>.=="a__b"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames wrapping CamelSnake toIdentifier role
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.wrap([@sutil:CamelSnakeConverter].@INSTANCE).toIdentifier("role")
          </subjectX>
          <testX>.=="role"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>MemberNames wrapping CamelSnake toMember role
          </name>
          <subjectX>[@json:MemberNames].@DEFAULT.wrap([@sutil:CamelSnakeConverter].@INSTANCE).toMember("role")
          </subjectX>
          <testX>.=="role"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>FromJson camelCase separators
          </name>
          <subjectX>"{\"finish_reason\":\"stop\",\"max-tokens\":\"9\"}"
            .[*json:FromJson{ { finishReason:[@j:String], maxTokens:[@j:String] } }]
          </subjectX>
          <testX>.finishReason=="stop" &amp;&amp; .maxTokens=="9"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>FromJson keeps a trailing separator as written
          </name>
          <subjectX>"{\"name_\":\"x\"}"
            .[*json:FromJson{ { name_:[@j:String] } }]
          </subjectX>
          <testX>.name_=="x"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>ToJson identifierConverter names out
          </name>
          <subjectX>[@jt:ChatDto].()
            .[*json:ToJson{ identifierConverter:=[@sutil:CamelSnakeConverter].@INSTANCE }]
          </subjectX>
          <testX><![CDATA[
            .contains("\"max_tokens\" :  64")
            && .contains("\"tool_call_id\" :  \"call_1\"")
            && .contains("\"top_p\" :  0.5")
            && .contains("\"@meta\" :  \"m\"")
            && !.contains("maxTokens")
            ]]>
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>ToJson without identifierConverter writes names as they are
          </name>
          <subjectX>[@jt:ChatDto].().[*json:ToJson]
          </subjectX>
          <testX><![CDATA[
            .contains("\"maxTokens\" :  64")
            && .contains("\"toolCallId\"")
            && .contains("\"@meta\"")
            ]]>
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>ToJson writes a Node property as its subtree, names as written
          </name>
          <subjectX>{ toolSchema:=[@jt:ToolDto].@SCHEMA }
            .[*json:ToJson{ identifierConverter:=[@sutil:CamelSnakeConverter].@INSTANCE }]
          </subjectX>
          <textLiteral whitespace="true" normalizeEOL="true"><![CDATA[
{"tool_schema" :  
  {"type" :  "object",
    "additionalProperties" :  false,
    "properties" :  
    {"locationName" :  
      {"type" :  "string"
      }
    }
  }
}]]></textLiteral>
        </test:Assertion>

        <test:Assertion>
          <name>A Node written twice gives the same text and is unchanged
          </name>
          <subjectX>
            { a:={ toolSchema:=[@jt:ToolDto].@SCHEMA }
                .[*json:ToJson{ identifierConverter:=[@sutil:CamelSnakeConverter].@INSTANCE }]
            , b:={ toolSchema:=[@jt:ToolDto].@SCHEMA }
                .[*json:ToJson{ identifierConverter:=[@sutil:CamelSnakeConverter].@INSTANCE }]
            , name:=[@jt:ToolDto].@SCHEMA.name
            , childName:=[@jt:ToolDto].@SCHEMA.children[0].name
            }
          </subjectX>
          <testX><![CDATA[
            .a==.b && .a.contains("\"additionalProperties\" :  false")
            && .name==null && .childName==null
            ]]>
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>ToJson renderAsIs writes a bean's Node property as its subtree
          </name>
          <subjectX>[@jt:ToolDto].()
            .[*json:ToJson{ renderAsIs:=true, identifierConverter:=[@sutil:CamelSnakeConverter].@INSTANCE }]
          </subjectX>
          <textLiteral whitespace="true" normalizeEOL="true"><![CDATA[
{"tool_schema" :  
  {"type" :  "object",
    "additionalProperties" :  false,
    "properties" :  
    {"locationName" :  
      {"type" :  "string"
      }
    }
  }
}]]></textLiteral>
        </test:Assertion>

        <test:Assertion>
          <name>ToJson renderAsIs maps names out
          </name>
          <subjectX>[@jt:ChatDto].()
            .[*json:ToJson{ renderAsIs:=true, identifierConverter:=[@sutil:CamelSnakeConverter].@INSTANCE }]
          </subjectX>
          <testX><![CDATA[
            .contains("\"max_tokens\" :  64")
            && .contains("\"tool_call_id\" :  \"call_1\"")
            && .contains("\"top_p\" :  0.5")
            && .contains("\"@meta\" :  \"m\"")
            && !.contains("maxTokens")
            ]]>
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>ToJson without renderAsIs still converts a bean to a tuple
          </name>
          <subjectX>[@jt:ToolDto].()
            .[*json:ToJson{ identifierConverter:=[@sutil:CamelSnakeConverter].@INSTANCE }]
          </subjectX>
          <testX>!.contains("tool_schema")
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>ToJson renderAsIs leaves a struct as it was
          </name>
          <subjectX>{ name:="John Doe", amount:=15.432 }
            .[*json:ToJson{ renderAsIs:=true }]
          </subjectX>
          <textLiteral whitespace="true" normalizeEOL="true"><![CDATA[
{"name" :  "John Doe",
  "amount" :  15.432
}]]></textLiteral>
        </test:Assertion>

        <test:Assertion>
          <name>ToJson renderAsIs leaves data in tuple form as it was
          </name>
          <subjectX>
            { a:=[*jn:URI{"in/test2-foreign.json"}]
              .[*vfsf:Resolve]
              .[*vfsf:IO]
              .[*json:FromJson{[@example:Customer]}]
              .[*json:ToJson]
            , b:=[*jn:URI{"in/test2-foreign.json"}]
              .[*vfsf:Resolve]
              .[*vfsf:IO]
              .[*json:FromJson{[@example:Customer]}]
              .[*json:ToJson{ renderAsIs:=true }]
            }
          </subjectX>
          <testX>.a==.b &amp;&amp; .a.length()&gt;20
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>ToJson escapes a member name
          </name>
          <subjectX>{ toolSchema:=
              [@json:Node].@parse
                ([@j:String]
                  .([*jn:URI{"in/test6-escaped-name.json"}]
                    .[*vfsf:Resolve]
                    .[*vfsf:IO]
                  )
                )
            }.[*json:ToJson]
          </subjectX>
          <testX><![CDATA[
            [@json:Node].@parse(.).children[0].children[0].children[0].name.length()==5
            && [@json:Node].@parse(.).children[0].children[0].children[0].name.startsWith("a\"b")
            && [@json:Node].@parse(.).children[0].children[0].children[0].name.endsWith("c")
            ]]>
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>DataWriter memberNames, a bean with a Node property
          </name>
          <subjectX>[@jt:DirectWrite].@write([@jt:ToolDto].())
          </subjectX>
          <testX><![CDATA[
            .contains("\"tool_schema\" :  {\"type\" :  \"object\"")
            && .contains("\"locationName\" :  {\"type\" :  \"string\"}")
            && .contains("\"additionalProperties\" :  false")
            ]]>
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>DataWriter memberNames, names out and as they are
          </name>
          <subjectX>
            { out:=[@jt:DirectWrite].@write([@jt:ChatDto].())
            , asIs:=[@jt:DirectWrite].@writeAsIs([@jt:ChatDto].())
            }
          </subjectX>
          <testX><![CDATA[
            .out.contains("\"max_tokens\" :  64") && .out.contains("\"@meta\"")
            && .asIs.contains("\"maxTokens\" :  64") && .asIs.contains("\"@meta\"")
            ]]>
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>DataWriter writes a Node as itself, and a scalar Node as a value
          </name>
          <subjectX>
            { root:=[@jt:DirectWrite].@writeNode([@json:Node].@parse("{\"a\":[1]}"))
            , scalars:=[@jt:DirectWrite].@writeScalars()
            }
          </subjectX>
          <testX><![CDATA[
            .root=="{\"a\" :  [1]}"
            && .scalars=="{\"tool_schema\" :  \"s\"} {\"tool_schema\" :  12} {\"tool_schema\" :  true} {\"tool_schema\" :  null}"
            ]]>
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>FromJson identifierConverter maps names with no camelCase separators
          </name>
          <subjectX>[@jt:DirectRead].@read("{\"max_tokens\":7,\"tool_call_id\":\"c9\",\"top_p\":0.25,\"@meta\":\"z\"}",true)
          </subjectX>
          <testX>.=="7 c9 0.25 z"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>FromJson without identifierConverter and separators does not map snake_case
          </name>
          <subjectX>[@jt:DirectRead].@read("{\"max_tokens\":7,\"tool_call_id\":\"c9\",\"top_p\":0.25,\"@meta\":\"z\"}",false)
          </subjectX>
          <testX>.=="error spiralcraft.lang.AccessException"
          </testX>
        </test:Assertion>

        <test:Assertion>
          <name>FromJson identifierConverter round trip
          </name>
          <subjectX>[@jt:ChatDto].()
            .[*json:ToJson{ identifierConverter:=[@sutil:CamelSnakeConverter].@INSTANCE }]
            .[*json:FromJson{ [@jt:ChatDto], identifierConverter:=[@sutil:CamelSnakeConverter].@INSTANCE }]
          </subjectX>
          <testX>.maxTokens==64 &amp;&amp; .toolCallId=="call_1" &amp;&amp; .topP==0.5 &amp;&amp; .__at__meta=="m"
          </testX>
        </test:Assertion>

      </scenarios>
    </task:Sequence>
  </chain>
</test:TestGroup>


